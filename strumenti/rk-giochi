#!/bin/bash
# FMLAB Retro - rk-giochi: i giochi li mette l'utente, FMLAB Retro non ne fornisce nessuno.
#   rk-giochi importa            prende i file messi in Shared/Giochi (app File dell'iPhone)
#   rk-giochi importa FILE...    prende i file indicati
#   rk-giochi scarica LINK       scarica da un link che dai tu
#   rk-giochi elenco             cosa c'è, per console
#   rk-giochi togli NOME         elimina un gioco
#   rk-giochi bios FILE...       mette i BIOS (servono a qualche console; anche questi li metti tu)
# I file vanno in ~/Giochi/<console>/ e compaiono negli elenchi di RetroArch.
set -u
VERSIONE="0.2.0"
GIOCHI="${RK_GIOCHI:-$HOME/Giochi}"
PLAYLIST="${RK_PLAYLIST:-$HOME/.config/retroarch/playlists}"
BIOS="${RK_BIOS:-$HOME/.config/retroarch/system}"
v() { printf '\033[%sm' "$1"; }
ok()  { printf '  %s✔%s %s\n' "$(v 32)" "$(v 0)" "$*"; }
no()  { printf '  %s✘%s %s\n' "$(v 31)" "$(v 0)" "$*"; }

# estensione -> console|core (core = nome del file libretro, senza _libretro.so)
console_di() {
  case "${1,,}" in
    *.nes|*.fds) echo "NES|nestopia";;
    *.gb) echo "Game Boy|gambatte";;
    *.gbc) echo "Game Boy Color|gambatte";;
    *.gba) echo "Game Boy Advance|mgba";;
    *.sfc|*.smc) echo "Super Nintendo|snes9x";;
    *.md|*.gen|*.smd) echo "Mega Drive|genesis_plus_gx";;
    *.sms) echo "Master System|genesis_plus_gx";;
    *.gg) echo "Game Gear|genesis_plus_gx";;
    *.pce) echo "PC Engine|mednafen_pce_fast";;
    *.nds) echo "Nintendo DS|desmume";;
    *) echo "";;
  esac
}
# uno zip: la console la dice il file che c'è dentro
console_zip() { local n; n=$(unzip -Z1 "$1" 2>/dev/null | grep -v '/$' | head -1); [ -n "$n" ] && console_di "$n"; }

shared() { local d; for d in /mnt/LinuxRunnerShared "$HOME/Shared"; do [ -d "$d" ] && { echo "$d"; return; }; done; }

core_so() { local f; for f in /usr/lib/*/libretro/"$1"_libretro.so /usr/lib/libretro/"$1"_libretro.so; do [ -f "$f" ] && { echo "$f"; return; }; done; echo "DETECT"; }

aggiorna_playlist() {  # un elenco RetroArch (.lpl, JSON) per ogni cartella di console
  mkdir -p "$PLAYLIST"
  python3 - "$GIOCHI" "$PLAYLIST" <<'PY'
import json, os, sys, glob
giochi, pl = sys.argv[1], sys.argv[2]
core = {"NES": "nestopia", "Game Boy": "gambatte", "Game Boy Color": "gambatte", "Game Boy Advance": "mgba",
        "Super Nintendo": "snes9x", "Mega Drive": "genesis_plus_gx", "Master System": "genesis_plus_gx",
        "Game Gear": "genesis_plus_gx", "PC Engine": "mednafen_pce_fast", "Nintendo DS": "desmume"}
# se il core preferito non c'è, il primo disponibile tra quelli che fanno la stessa console (Debian 13 ha bsnes, non snes9x)
riserva = {"snes9x": ["snes9x2010", "bsnes_mercury_performance", "bsnes_mercury_balanced"]}
def so(n):
    for nome in [n] + riserva.get(n, []):
        for f in glob.glob(f"/usr/lib/*/libretro/{nome}_libretro.so") + [f"/usr/lib/libretro/{nome}_libretro.so"]:
            if os.path.exists(f): return f
    return "DETECT"
for c in sorted(os.listdir(giochi)) if os.path.isdir(giochi) else []:
    d = os.path.join(giochi, c)
    if not os.path.isdir(d) or c not in core: continue
    items = [{"path": os.path.join(d, f), "label": os.path.splitext(f)[0], "core_path": so(core[c]),
              "core_name": "DETECT", "crc32": "DETECT", "db_name": f"FMLAB Retro - {c}.lpl"}
             for f in sorted(os.listdir(d)) if not f.startswith(".")]
    with open(os.path.join(pl, f"FMLAB Retro - {c}.lpl"), "w") as fh:
        json.dump({"version": "1.5", "default_core_path": so(core[c]), "default_core_name": "", "items": items}, fh, indent=2)
PY
}

metti() {  # $1 file -> nella cartella della sua console
  local f=$1 cc nome
  [ -f "$f" ] || { no "$f: non esiste"; return 1; }
  case "${f,,}" in *.zip) cc=$(console_zip "$f");; *) cc=$(console_di "$f");; esac
  [ -n "$cc" ] || { no "$(basename "$f"): tipo non riconosciuto (nes, gb, gbc, gba, sfc, smc, md, sms, gg, pce, nds, zip)"; return 1; }
  nome=${cc%%|*}
  mkdir -p "$GIOCHI/$nome"
  if [ -e "$GIOCHI/$nome/$(basename "$f")" ]; then no "$(basename "$f"): c'è già in $nome"; return 1; fi
  cp -- "$f" "$GIOCHI/$nome/" && ok "$(basename "$f") → $nome"
}

case "${1:-}" in
  importa)
    shift
    if [ $# -eq 0 ]; then
      s=$(shared); [ -n "$s" ] || { no "cartella Shared non trovata"; exit 1; }
      mkdir -p "$s/Giochi"
      shopt -s nullglob; files=("$s"/Giochi/*); shopt -u nullglob
      if [ ${#files[@]} -eq 0 ]; then
        echo "Metti i tuoi giochi nell'app File: In questo iPhone > FMLAB Linux > Shared > Giochi, poi rilancia."
        exit 0
      fi
      set -- "${files[@]}"
    fi
    n=0; for f in "$@"; do metti "$f" && n=$((n + 1)); done
    aggiorna_playlist; echo "Importati: $n. Aprili da RetroArch → Elenchi (FMLAB Retro - <console>)."
    ;;
  scarica)
    [ -n "${2:-}" ] || { echo "Uso: rk-giochi scarica LINK"; exit 2; }
    case "$2" in https://*|http://*) ;; *) no "serve un link http(s)"; exit 2;; esac
    t=$(mktemp -d); nome=$(basename "${2%%\?*}")
    [ -n "$nome" ] && [ "$nome" != "/" ] || nome=gioco
    if curl -fL --retry 2 --max-time 600 -o "$t/$nome" "$2"; then metti "$t/$nome"; aggiorna_playlist
    else no "download non riuscito"; fi
    rm -rf "$t"
    ;;
  elenco)
    [ -d "$GIOCHI" ] || { echo "Nessun gioco. Usa: rk-giochi importa"; exit 0; }
    for d in "$GIOCHI"/*/; do
      [ -d "$d" ] || continue
      n=$(find "$d" -maxdepth 1 -type f | wc -l)
      printf '%s%s%s (%d)\n' "$(v 1)" "$(basename "$d")" "$(v 0)" "$n"
      find "$d" -maxdepth 1 -type f -printf '  %f\n' | sort
    done
    ;;
  togli)
    [ -n "${2:-}" ] || { echo "Uso: rk-giochi togli NOME"; exit 2; }
    trovati=$(find "$GIOCHI" -mindepth 2 -maxdepth 2 -type f -name "$2" 2>/dev/null)
    [ -n "$trovati" ] || trovati=$(find "$GIOCHI" -mindepth 2 -maxdepth 2 -type f -name "$2.*" 2>/dev/null)
    [ -n "$trovati" ] || { no "$2: non trovato (rk-giochi elenco)"; exit 1; }
    while IFS= read -r f; do rm -f -- "$f" && ok "tolto $(basename "$f")"; done <<< "$trovati"
    aggiorna_playlist
    ;;
  bios)
    shift; mkdir -p "$BIOS"
    for f in "$@"; do [ -f "$f" ] && cp -- "$f" "$BIOS/" && ok "BIOS $(basename "$f")" || no "$f: non esiste"; done
    ;;
  --versione) echo "rk-giochi $VERSIONE" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
