#!/bin/sh
# FMLAB Retro: apre RetroArch con le impostazioni FMLAB.
# La base si copia solo la prima volta: quello che cambi da RetroArch resta tuo anche dopo gli aggiornamenti.
case "${1:-}" in
  --versione) dpkg-query -W -f='FMLAB Retro ${Version}\n' fmlab-retro 2>/dev/null; exit 0 ;;
  --ripristina) rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/retroarch/retroarch.cfg"; echo "Impostazioni FMLAB rimesse: riapri FMLAB Retro"; exit 0 ;;
esac
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/retroarch/retroarch.cfg"
if [ ! -f "$cfg" ]; then
  mkdir -p "$(dirname "$cfg")"
  sed "s#@HOME@#$HOME#g" /usr/share/fmlab-retro/retroarch.cfg > "$cfg"
fi
mkdir -p "$HOME/Giochi/salvataggi" "${XDG_CONFIG_HOME:-$HOME/.config}/retroarch/playlists" "${XDG_CONFIG_HOME:-$HOME/.config}/retroarch/system"
exec retroarch "$@"
